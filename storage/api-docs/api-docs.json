{
    "openapi": "3.0.0",
    "info": {
        "title": "Personal Finance Management API",
        "description": "Tài liệu API cho dự án quản lý tài chính cá nhân",
        "contact": {
            "email": "dinh.van.luan@sun-asterisk.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Localhost server"
        }
    ],
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Đăng nhập tài khoản",
                "description": "Login endpoint",
                "operationId": "6ccc9dfb83bd463dd446668cc8babee4",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "12345678"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Đăng nhập thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "access_token": {
                                            "type": "string"
                                        },
                                        "refresh_token": {
                                            "type": "string"
                                        },
                                        "token_type": {
                                            "type": "string"
                                        },
                                        "access_token_expires_at": {
                                            "type": "string",
                                            "format": "date-time"
                                        },
                                        "refresh_token_expires_at": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Đăng nhập thất bại"
                    }
                }
            }
        },
        "/api/refresh": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Làm mới access token",
                "description": "Dùng refresh_token hợp lệ để lấy access_token mới và refresh_token mới.",
                "operationId": "3fa6267fd3d0407dbd0a8f2d8c71ce85",
                "responses": {
                    "200": {
                        "description": "Thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "access_token": {
                                            "type": "string"
                                        },
                                        "refresh_token": {
                                            "type": "string"
                                        },
                                        "access_token_expires_at": {
                                            "type": "string",
                                            "format": "date-time"
                                        },
                                        "refresh_token_expires_at": {
                                            "type": "string",
                                            "format": "date-time"
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "Bearer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Refresh token không hợp lệ hoặc hết hạn"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/profile": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Lấy thông tin người dùng",
                "description": "Trả về thông tin của người dùng đang đăng nhập.",
                "operationId": "efb1d2e43e1a46284bb9f90b0332090c",
                "responses": {
                    "200": {
                        "description": "Thông tin người dùng",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "Luan"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "luan@example.com"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/wallet": {
            "post": {
                "tags": [
                    "Wallet"
                ],
                "summary": "Tạo ví mới",
                "description": "Tạo ví mới với loại: basic, saving, credit. Cần token xác thực.",
                "operationId": "f697473ff44c1883711dacc965654d4b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "required": [
                                            "name",
                                            "balance",
                                            "currency_id",
                                            "wallet_type"
                                        ],
                                        "properties": {
                                            "name": {
                                                "type": "string",
                                                "example": "My Wallet"
                                            },
                                            "balance": {
                                                "type": "number",
                                                "format": "float",
                                                "example": 1000
                                            },
                                            "currency_id": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "wallet_type": {
                                                "type": "string",
                                                "enum": [
                                                    "basic"
                                                ],
                                                "example": "basic"
                                            }
                                        },
                                        "type": "object"
                                    },
                                    {
                                        "required": [
                                            "name",
                                            "balance",
                                            "currency_id",
                                            "wallet_type",
                                            "target_amount",
                                            "end_date"
                                        ],
                                        "properties": {
                                            "name": {
                                                "type": "string",
                                                "example": "Saving Wallet"
                                            },
                                            "balance": {
                                                "type": "number",
                                                "format": "float",
                                                "example": 500
                                            },
                                            "currency_id": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "wallet_type": {
                                                "type": "string",
                                                "enum": [
                                                    "saving"
                                                ],
                                                "example": "saving"
                                            },
                                            "target_amount": {
                                                "type": "number",
                                                "format": "float",
                                                "example": 10000
                                            },
                                            "end_date": {
                                                "type": "string",
                                                "format": "date",
                                                "example": "2025-12-31"
                                            }
                                        },
                                        "type": "object"
                                    },
                                    {
                                        "required": [
                                            "name",
                                            "balance",
                                            "currency_id",
                                            "wallet_type",
                                            "credit_limit",
                                            "statement_date",
                                            "payment_due_date"
                                        ],
                                        "properties": {
                                            "name": {
                                                "type": "string",
                                                "example": "Credit Card Wallet"
                                            },
                                            "balance": {
                                                "type": "number",
                                                "format": "float",
                                                "example": 200
                                            },
                                            "currency_id": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "wallet_type": {
                                                "type": "string",
                                                "enum": [
                                                    "credit"
                                                ],
                                                "example": "credit"
                                            },
                                            "credit_limit": {
                                                "type": "number",
                                                "format": "float",
                                                "example": 5000
                                            },
                                            "statement_date": {
                                                "type": "string",
                                                "format": "date",
                                                "example": "2025-07-01"
                                            },
                                            "payment_due_date": {
                                                "type": "string",
                                                "format": "date",
                                                "example": "2025-07-15"
                                            }
                                        },
                                        "type": "object"
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Tạo ví thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "wallet": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "My Wallet"
                                                },
                                                "balance": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "example": 1000
                                                },
                                                "wallet_type": {
                                                    "type": "string",
                                                    "example": "basic"
                                                },
                                                "currency_id": {
                                                    "type": "integer",
                                                    "example": 1
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Dữ liệu không hợp lệ"
                    },
                    "500": {
                        "description": "Tạo ví thất bại do lỗi server"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Bearer Token dùng cho xác thực",
                "name": "Authorization",
                "in": "header",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Wallet",
            "description": "Wallet"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ]
}